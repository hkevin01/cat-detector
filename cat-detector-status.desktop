[Desktop Entry]
Type=Application
Version=1.0
Name=Cat Detector Status
Comment=Open the cat-detector runtime status page
Exec=/bin/sh -lc "$HOME/.local/share/cat-detector/venv/bin/cat-detector-open-status"
Icon=cat-detector-status
Terminal=false
Categories=Utility;System;
Actions=OpenHeartbeat;

[Desktop Action OpenHeartbeat]
Name=Open Raw Heartbeat JSON
Exec=/bin/sh -lc "$HOME/.local/share/cat-detector/venv/bin/cat-detector-open-heartbeat"