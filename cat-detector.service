[Unit]
Description=Cat on Keyboard Detector
Documentation=https://github.com/hkevin01/cat-detector
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=simple
WorkingDirectory=%h/.local/share/cat-detector
Environment=PATH=%h/.local/share/cat-detector/venv/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=%h/.local/share/cat-detector/venv/bin/cat-detector
Restart=on-failure
RestartSec=30
RestartSteps=3
RestartMaxDelaySec=120
Environment=DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/%U/bus
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=graphical-session.target
